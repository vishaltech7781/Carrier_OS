# Environment Variables Example for CareerOS AI

# Node.js Express Backend
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Authentication
JWT_SECRET=careeros_super_secret_jwt_key_2026_dev_mode_change_in_production
JWT_EXPIRES_IN=7d

# Databases
# MongoDB for flexible documents (Users, Profiles, Resumes, Interview Sessions)
MONGODB_URI=mongodb://127.0.0.1:27017/careeros_ai

# MySQL with Prisma for relational data (Skills, Roadmaps, DSA problems, Jobs, Applications)
DATABASE_URL=mysql://root:root@localhost:3306/careeros_db

# Optional Redis for Caching / Rate Limiting (Fallback to in-memory if empty)
REDIS_URL=

# AI Microservice (FastAPI)
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# File Uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

